# Sepolia RPC endpoint (Alchemy, Infura, etc.)
SEPOLIA_RPC_URL=

# Deployer / payroll admin private key (test wallet only — never a real fund-holding key)
DEPLOYER_PRIVATE_KEY=

# Underlying stablecoin address on Sepolia.
# Leave empty to deploy the local MockUSDC instead.
USDC_ADDRESS=

# Company Safe address (the confidential treasury). Must already exist on Sepolia.
SAFE_ADDRESS=

# Filled in after `pnpm deploy:sepolia` runs
CONFIDENTIAL_USDC_ADDRESS=
PAYROLL_VAULT_ADDRESS=

# Etherscan verification (optional)
ETHERSCAN_API_KEY=
